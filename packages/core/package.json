{
  "name": "@service-monitor/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./security/password": {
      "types": "./dist/security/password.d.ts",
      "import": "./dist/security/password.js",
      "require": "./dist/security/password.js",
      "default": "./dist/security/password.js"
    },
    "./security/cash-dev-password": {
      "types": "./dist/security/cash-dev-password.d.ts",
      "import": "./dist/security/cash-dev-password.js",
      "require": "./dist/security/cash-dev-password.js",
      "default": "./dist/security/cash-dev-password.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "test:stage0": "npm run build && node --test dist/stage0.test.js",
    "test:stage1": "npm run build && node --test dist/stage1.test.js",
    "test:stage2": "npm run build && node --test dist/stage2.test.js",
    "test:stage3": "npm run build && node --test dist/stage3.test.js"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}